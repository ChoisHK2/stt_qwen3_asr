# 프로덕션: 1.7B 모델 (B200 MIG 30GB, 100 커넥션)
# 사용법: cp .env.prod .env && docker compose --profile prod up
APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://redis:6379/0
VLLM_BASE_URL=http://vllm-prod:8001
VLLM_MODEL=Qwen/Qwen3-ASR-1.7B
MAX_CONCURRENT_ASR=32
ASR_TIMEOUT_SEC=30
PARTIAL_MODE=on
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
DIAR_DEVICE=auto
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
MODEL_DIR=/models
