# 프로덕션: 1.7B 모델 (B200 MIG 30GB, 100 커넥션)
# 사용법: docker build -t qwen3-stt . && docker run --gpus all --env-file .env -v ./models:/models -p 8000:8000 qwen3-stt
APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://localhost:6379/0
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=Qwen/Qwen3-ASR-1.7B
VLLM_MODEL_PATH=/models/Qwen3-ASR-1.7B
VLLM_MODEL_NAME=Qwen/Qwen3-ASR-1.7B
VLLM_GPU_UTIL=0.90
VLLM_MAX_NUM_SEQS=32
MAX_CONCURRENT_ASR=32
ASR_TIMEOUT_SEC=30
PARTIAL_MODE=on
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
PYANNOTE_LOCAL_PATH=/models/pyannote/speaker-diarization-community-1
DIAR_DEVICE=auto
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
MODEL_DIR=/models

# HTTPS (선택사항 - 비어있으면 HTTP)
# 사용시: docker run ... -v ./cert:/cert -e SSL_KEYFILE=/cert/key.pem -e SSL_CERTFILE=/cert/cert.pem
SSL_KEYFILE=
SSL_CERTFILE=
