APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SEC=10800
PARTIAL_MODE=on
OVERLOAD_HTTP_CODE=429
SESSION_QUEUE_LIMIT=16
GLOBAL_QUEUE_LIMIT=2000
WORKER_CONCURRENCY=2
BACKPRESSURE_SLOW_RATIO=0.6
BACKPRESSURE_PAUSE_RATIO=0.9
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
ENABLE_VAD=false
TARGET_RMS_DBFS=-20.0
LIMITER_PEAK_DBFS=-1.0
VLLM_BASE_URL=http://vllm:8001
