APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SEC=10800
PARTIAL_MODE=on
OVERLOAD_HTTP_CODE=429
# vLLM이 자체 큐잉/배칭 처리하므로 이 값은 API→vLLM 동시 요청 제한용
MAX_CONCURRENT_ASR=32
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
ENABLE_VAD=false
TARGET_RMS_DBFS=-20.0
LIMITER_PEAK_DBFS=-1.0
# 모델: 0.6B(dev) 또는 1.7B(prod) - docker-compose profile에 맞춰 설정
VLLM_BASE_URL=http://vllm-dev:8001
VLLM_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_TIMEOUT_SEC=30
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_LOCAL_PATH=/models/pyannote-speaker-diarization
PYANNOTE_TOKEN=
DIAR_DEVICE=cpu
MATCHING_FALLBACK=segment_majority
OVERLAP_POLICY=dominant
MERGE_MODE=gap
MERGE_GAP_SEC=0.35
MIN_TURN_SEC=0.4
MAX_TURN_SEC=15.0
MIN_WORDS_PER_TURN=1
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
FINALIZE_ASYNC_THRESHOLD_SEC=480
MODEL_DIR=/models
