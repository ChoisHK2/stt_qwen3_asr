# ============================================================
# 올인원 Docker 이미지용 환경변수
# ============================================================
# 사용법:
#   cp .env.dev .env    (개발) 또는  cp .env.prod .env  (프로덕션)
#   docker build -t qwen3-stt .
#   docker run --gpus all --env-file .env -v ./models:/models -p 8000:8000 qwen3-stt
# ============================================================

# ── API 서버 ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Redis (컨테이너 내장) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SEC=14400

# ── vLLM ASR 서버 (컨테이너 내장) ──────────────────────────
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=Qwen/Qwen3-ASR-0.6B
VLLM_MODEL_PATH=/models/Qwen3-ASR-0.6B
VLLM_MODEL_NAME=Qwen/Qwen3-ASR-0.6B
VLLM_PORT=8001
VLLM_GPU_UTIL=0.85
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=4
ASR_TIMEOUT_SEC=30

# ── 동시성 ──────────────────────────────────────────────────
# vLLM이 자체 continuous batching으로 큐잉하므로, 이 값은 API→vLLM 세마포어
MAX_CONCURRENT_ASR=4
OVERLOAD_HTTP_CODE=429
PARTIAL_MODE=on

# ── 오디오 전처리 ──────────────────────────────────────────
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
ENABLE_VAD=false
TARGET_RMS_DBFS=-20.0
LIMITER_PEAK_DBFS=-1.0

# ── 화자분리 (pyannote) ───────────────────────────────────
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_LOCAL_PATH=/models/pyannote/speaker-diarization-community-1
PYANNOTE_TOKEN=
DIAR_DEVICE=cpu

# ── 매칭 / 병합 ───────────────────────────────────────────
MATCHING_FALLBACK=segment_majority
OVERLAP_POLICY=dominant
MERGE_MODE=gap
MERGE_GAP_SEC=0.35
MIN_TURN_SEC=0.4
MAX_TURN_SEC=15.0
MIN_WORDS_PER_TURN=1

# ── 세션 ───────────────────────────────────────────────────
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
FINALIZE_ASYNC_THRESHOLD_SEC=480
AUDIO_DATA_DIR=data/audio
MODEL_DIR=/models

# ── HTTPS (선택사항) ──────────────────────────────────────
# 비어있으면 HTTP, 설정하면 HTTPS 활성화
# docker run ... -v ./cert:/cert -e SSL_KEYFILE=/cert/key.pem -e SSL_CERTFILE=/cert/cert.pem
SSL_KEYFILE=
SSL_CERTFILE=
