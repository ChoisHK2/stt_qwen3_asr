# 개발용: 0.6B 모델 (개인 PC, 소형 GPU)
# 사용법: docker build -t qwen3-stt . && docker run --gpus all --env-file .env -v ./data:/app/data -p 8000:8000 qwen3-stt
APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://localhost:6379/0
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=Qwen/Qwen3-ASR-0.6B
VLLM_MODEL_PATH=/app/models/Qwen3-ASR-0.6B
VLLM_MODEL_NAME=Qwen/Qwen3-ASR-0.6B
VLLM_GPU_UTIL=0.6
VLLM_MAX_NUM_SEQS=4
MAX_CONCURRENT_ASR=4
ASR_TIMEOUT_SEC=300
PARTIAL_MODE=on
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
PYANNOTE_LOCAL_PATH=/app/models/pyannote/speaker-diarization-community-1
DIAR_DEVICE=cuda
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
MODEL_DIR=/app/models
