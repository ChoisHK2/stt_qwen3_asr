# 개발용: 0.6B 모델 (개인 PC, 소형 GPU)
# 사용법: cp .env.dev .env && docker compose --profile dev up
APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://redis:6379/0
VLLM_BASE_URL=http://vllm-dev:8001
VLLM_MODEL=Qwen/Qwen3-ASR-0.6B
MAX_CONCURRENT_ASR=4
ASR_TIMEOUT_SEC=30
PARTIAL_MODE=on
PREPROCESS_ENABLED=true
NOISE_REDUCTION_MODE=FAST
DIAR_DEVICE=cpu
STT_FINAL_CHUNK_SEC=60
MAX_SESSION_AUDIO_SEC=7200
MODEL_DIR=/models
